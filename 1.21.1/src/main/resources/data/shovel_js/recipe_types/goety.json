        ]
      ]
    },
    "rawJson": {
      "ritual_type": "$field:ritualType",
      "activation_item": "$field:activationItem:ingredient",
      "craftType": "$field:craftType",
      "soulCost": "$field:soulCost",
      "duration": "$field:duration",
      "ingredients": "$inputs:ingredient",
      "result": "$slot:output_item:item_stack",
      "entity_to_summon": "$field:entityToSummon",
      "summonLife": "$field:summonLife",
      "entity_to_sacrifice": {
        "tag": "$field:entityToSacrificeTag",
        "display_name": "$field:entityToSacrificeDisplayName"
      },
      "entity_to_convert": {
        "tag": "$field:entityToConvertTag",
        "display_name": "$field:entityToConvertDisplayName"
      },
      "entity_to_convert_into": "$field:entityToConvertInto",
      "structure_to_locate": {
        "tag": "$field:structureToLocateTag",
        "display_name": "$field:structureToLocateDisplayName"
      },
      "enchantment": "$field:enchantment",
      "xpLevelCost": "$field:xpLevelCost",
      "research": "$field:research"
