[
  {
    "recipeSerializer": "goety:ritual",
    "displayName": "Goety - Dark Altar Ritual",
    "stationItem": "goety:dark_altar",
    "modId": "goety",
    "extraFields": [
      {
        "key": "ritualType",
        "type": "string",
        "default": "goety:craft",
        "label": "Ritual Type (use the picker button above - a pack can also register custom ritual types via kubejs-goety's GoetyEvents.registerRitual, type any id here if yours isn't in the list)",
        "required": true,
        "options": [
          "goety:craft",
          "goety:enchant",
          "goety:summon",
          "goety:summon_tamed",
          "goety:convert",
          "goety:convert_tamed",
          "goety:convert_complete_tamed",
          "goety:teleport"
        ]
      },
      {
        "key": "activationItem",
        "type": "item",
        "default": "minecraft:ender_pearl",
        "label": "Activation Item",
        "required": true
      },
      {
        "key": "craftType",
        "type": "string",
        "default": "forge",
        "label": "Craft Type / ritual structure required (use the picker button above for the 5 confirmed against goety.wiki.gg's Rituals page - newer Goety versions add more, e.g. deep, frost, sky, storm, adept_nether, expert_nether, end, sabbath - type any of those manually if yours isn't listed)",
        "required": true,
        "options": [
          "forge",
          "animation",
          "geoturgy",
          "magic",
          "necroturgy"
        ]
      },
      {
        "key": "soulCost",
        "type": "int",
        "default": "5",
        "label": "Soul Cost"
      },
      {
        "key": "duration",
        "type": "int",
        "default": "20",
        "label": "Duration (seconds)"
      },
      {
        "key": "enchantment",
        "type": "string",
        "default": "",
        "label": "(only for ritualType=goety:enchant) Enchantment ID to apply - leave blank otherwise"
      },
      {
        "key": "xpLevelCost",
        "type": "int",
        "default": "0",
        "label": "(only for ritualType=goety:enchant) XP level cost - leave 0 otherwise"
      },
      {
        "key": "entityToSummon",
        "type": "string",
        "default": "",
        "label": "(only for ritualType=goety:summon / summon_tamed) Entity ID to summon - leave blank otherwise"
      },
      {
        "key": "summonLife",
        "type": "int",
        "default": "-1",
        "label": "(only for summon rituals) Summoned entity lifespan in ticks, -1 = permanent"
      },
      {
        "key": "entityToSacrificeTag",
        "type": "string",
        "default": "",
        "label": "(optional, any ritualType) Entity tag required as a sacrifice - leave blank if this ritual needs no sacrifice"
      },
      {
        "key": "entityToSacrificeDisplayName",
        "type": "string",
        "default": "",
        "label": "(pairs with entityToSacrificeTag) Display name for the sacrifice requirement"
      },
      {
        "key": "entityToConvertTag",
        "type": "string",
        "default": "",
        "label": "(only for ritualType=goety:convert / convert_tamed / convert_complete_tamed) Entity tag to convert - leave blank otherwise"
      },
      {
        "key": "entityToConvertDisplayName",
        "type": "string",
        "default": "",
        "label": "(pairs with entityToConvertTag) Display name for the entity being converted"
      },
      {
        "key": "entityToConvertInto",
        "type": "string",
        "default": "",
        "label": "(only for convert rituals) Entity ID to convert into - leave blank otherwise"
      },
      {
        "key": "research",
        "type": "string",
        "default": "",
        "label": "(optional) Required research id, e.g. 'forbidden', 'haunting' - leave blank if none required"
      },
      {
        "key": "structureToLocateTag",
        "type": "string",
        "default": "",
        "label": "Structure To Locate Tag (goety:locate)"
      },
      {
        "key": "structureToLocateDisplayName",
        "type": "string",
        "default": "",
        "label": "Structure To Locate Display Name"
      }
    ],
    "dedicatedCall": {
      "requiresMod": "goety",
      "requiresAddon": "kubejs-goety",
      "argsTemplate": "event.recipes.goety.ritual({output}, {field:ritualType}, {inputs}).activationItem({field:activationItem}).craftType({field:craftType}){extra}",
      "extraFieldCallTemplates": {
        "soulCost": ".soulCost({value})",
        "duration": ".duration({value})",
        "enchantment": ".enchantment({value})",
        "xpLevelCost": ".xpLevelCost({value})",
        "entityToSummon": ".entityToSummon({value})",
        "summonLife": ".summonLife({value})",
        "entityToSacrificeTag": ".entityToSacrificeTag({value})",
        "entityToSacrificeDisplayName": ".entityToSacrificeDisplayName({value})",
        "entityToConvertTag": ".entityToConvertTag({value})",
        "entityToConvertDisplayName": ".entityToConvertDisplayName({value})",
        "entityToConvertInto": ".entityToConvertInto({value})",
        "research": ".research({value})"
      },
      "preferOverRawJson": false
    },
    "slotLayout": {
      "slots": [
        {
          "id": "main_input",
          "role": "input",
          "type": "item",
          "x": 0,
          "y": 0,
          "required": true
        },
        {
          "id": "extra_input",
          "role": "input",
          "type": "item",
          "x": 20,
          "y": 0,
          "repeatable": true
        },
        {
          "id": "output_item",
          "role": "output",
          "type": "item",
          "x": 0,
          "y": 0,
          "required": true
        }
      ]
    },
    "editorView": "ritual_ring",
    "ritualView": {
      "maxOfferings": 12,
      "centerField": "activationItem",
      "ringFromInputs": true,
      "positions": [
        [
          0,
          -30
        ],
