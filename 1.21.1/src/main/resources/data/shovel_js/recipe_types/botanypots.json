[
  {
    "recipeSerializer": "botanypots:crop",
    "displayName": "Botany Pots - Crop",
    "modId": "botanypots",
    "stationItem": "botanypots:terracotta_botany_pot",
    "extraFields": [
      {
        "key": "soil",
        "type": "string",
        "default": "",
        "label": "Soil (item or #tag, optional - empty = any soil)"
      },
      {
        "key": "growTime",
        "type": "int",
        "default": "1200",
        "label": "Grow Time (ticks)"
      },
      {
        "key": "displayBlock",
        "type": "string",
        "default": "minecraft:wheat",
        "label": "Display block (block id shown in the pot)",
        "required": true
      }
    ],
    "dedicatedCall": {
      "requiresMod": "botanypots",
      "requiresAddon": "kubejs-botany-pots",
      "argsTemplate": "event.recipes.botanypots.crop({input} /* seed */, /* categories */ [], /* displayBlock */ {}, {output} /* drops, chance+rolls */, /* growthTicks */ 10, /* growthModifier */ 1){extra}",
      "extraFieldCallTemplates": {},
      "preferOverRawJson": false
    },
    "slotLayout": {
      "slots": [
        {
          "id": "main_input",
          "role": "input",
          "type": "item",
          "x": 0,
          "y": 0,
          "required": true,
          "maxCount": 1
        },
        {
          "id": "output_item",
          "role": "output",
          "type": "item",
          "x": 86,
          "y": 0,
          "required": true
        }
      ],
      "sameRow": true,
      "arrow": {
        "x": 64,
        "y": 3,
        "direction": "right"
      }
    },
    "rawJson": {
      "input": "$slot:main_input:ingredient",
      "soil": "$field:soil:ingredient",
      "grow_time": "$field:growTime",
      "display": {
        "type": "botanypots:simple",
        "block_state": {
          "block": "$field:displayBlock"
        }
      },
      "drops": [
        {
          "type": "botanypots:items",
          "items": "$outputs:bp_drop"
        }
      ]
    }
  },
  {
    "recipeSerializer": "botanypots:soil",
