      "argsTemplate": "event.recipes.botania.petal_apothecary({output}, {inputs})",
      "extraFieldCallTemplates": {},
      "preferOverRawJson": true
    },
    "slotLayout": {
      "slots": [
        {
          "id": "offering",
          "role": "input",
          "type": "item",
          "x": 0,
          "y": 0,
          "required": true,
          "repeatable": true
        },
        {
          "id": "output_item",
          "role": "output",
          "type": "item",
          "x": 160,
          "y": 0,
          "required": true
        }
      ],
      "unified": true,
      "arrow": {
        "x": 130,
        "y": 3,
        "direction": "right"
      }
    },
    "editorView": "ritual_ring",
    "ritualView": {
      "maxOfferings": 16,
      "ringFromInputs": true
    },
    "stationItem": "botania:petal_apothecary",
    "rawJson": {
      "ingredients": "$inputs:ingredient",
      "output": "$slot:output_item:item_stack",
      "reagent": "$field:reagent:ingredient"
    }
  },
