        "default": "255",
        "label": "Color Blue (0-255)"
      }
    ],
    "dedicatedCall": {
      "requiresMod": "ars_nouveau",
      "requiresAddon": "kubejs-ars-nouveau",
      "argsTemplate": "event.custom({ type: 'ars_nouveau:caster_tome', tome_type: 'ars_nouveau:caster_tome', name: {field:tomeName}, flavour_text: {field:flavourText}, color: { type: 'ars_nouveau:constant', red: 255, green: 255, blue: 255 } /* 1.20.1 shape - edit RGB or swap for a packed int on 1.20.4+ */, sound: { family: {field:soundFamily}, pitch: 1, volume: 1 }, spell: {field:spellGlyphs} }).id('shovel_js:example_tome')",
      "extraFieldCallTemplates": {},
      "preferOverRawJson": false
    },
    "rawJson": {
      "tome_type": "ars_nouveau:caster_tome",
      "name": "$field:tomeName",
      "flavour_text": "$field:flavourText",
      "color": {
        "type": "ars_nouveau:constant",
        "red": "$field:colorRed",
        "green": "$field:colorGreen",
        "blue": "$field:colorBlue"
      },
      "sound": {
        "family": "$field:soundFamily",
        "pitch": 1.0,
        "volume": 1.0
      },
      "spell": "$field:spellGlyphs:list"
    }
  },
