[
  {
    "recipeSerializer": "ars_nouveau:enchanting_apparatus",
    "displayName": "Ars Nouveau - Enchanting Apparatus",
    "modId": "ars_nouveau",
    "extraFields": [
      {
        "key": "reagent",
        "type": "item",
        "default": "",
        "label": "Reagent (central item)",
        "required": true
      },
      {
        "key": "sourceCost",
        "type": "int",
        "default": "1000",
        "label": "Source Cost"
      },
      {
        "key": "keepNbtOfReagent",
        "type": "boolean",
        "default": "false",
        "label": "Keep NBT of Reagent (like a smithing recipe)"
      }
    ],
    "dedicatedCall": {
      "requiresMod": "ars_nouveau",
      "requiresAddon": "kubejs-ars-nouveau",
      "argsTemplate": "event.recipes.ars_nouveau.enchanting_apparatus({inputs}, {field:reagent}, {output}, {field:sourceCost}, {field:keepNbtOfReagent})",
      "extraFieldCallTemplates": {},
      "preferOverRawJson": true
    },
    "slotLayout": {
      "slots": [
        {
          "id": "pedestal_input",
          "role": "input",
          "type": "item",
          "x": 20,
          "y": 0,
          "repeatable": true
        },
        {
          "id": "output_item",
          "role": "output",
          "type": "item",
          "x": 160,
          "y": 0,
          "required": true
        }
      ],
      "unified": true,
      "arrow": {
        "x": 130,
        "y": 3,
        "direction": "right"
      }
    },
    "editorView": "ritual_ring",
    "ritualView": {
      "maxOfferings": 8,
      "centerField": "reagent",
      "ringFromInputs": true
    },
    "stationItem": "ars_nouveau:enchanting_apparatus",
    "rawJson": {
      "reagent": [
        "$field:reagent:ingredient"
      ],
      "pedestalItems": "$inputs:ingredient||[]",
      "output": "$slot:output_item:item_stack",
      "sourceCost": "$field:sourceCost",
      "keepNbtOfReagent": "$field:keepNbtOfReagent"
    }
  },
